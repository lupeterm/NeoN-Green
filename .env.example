# copy to .env — read by docker-compose.yml and the ingestor stack
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=atrai_bikes

# openSenseMap grouptags to ingest (senseBox:bike campaign in Heilbronn)
GROUPTAGS=heilbronn
# first day pulled from the archive for boxes without sync history
DEFAULT_START_DATE=2026-01-01
# hours between archive syncs
SYNC_INTERVAL_HOURS=6

INT_API_TOKEN=changeme_strong_token
APP_PORT=8000
MARTIN_PORT=3000
WEB_PORT=8080
LOG_LEVEL=INFO
